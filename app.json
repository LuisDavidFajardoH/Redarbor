{
  "expo": {
    "name": "Remota",
    "slug": "Remota",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/IconREMOTA.png",
    "scheme": "remota",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "icon": "./assets/images/IconREMOTA.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#6366F1",
        "foregroundImage": "./assets/images/IconREMOTA.png",
        "monochromeImage": "./assets/images/IconREMOTA.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/IconREMOTA.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0B0E",
          "image": "./assets/images/IconREMOTA.png",
          "imageWidth": 120,
          "android": {
            "image": "./assets/images/IconREMOTA.png",
            "imageWidth": 120
          }
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
